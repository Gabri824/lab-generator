--- rigenerato/rabe1.startup
+++ reale/rabe1.startup
@@ -2,4 +2,5 @@
 ip address add 50.7.1.1/24 dev eth1
 ip address add 100.1.2.1/24 dev eth2
 
+ip address add 2.2.2.2/32 dev lo
