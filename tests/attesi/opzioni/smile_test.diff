--- rigenerato/rabe1/etc/frr/frr.conf
+++ reale/rabe1/etc/frr/frr.conf
@@ -12,7 +12,9 @@
     network 100.0.0.0/8
 
     redistribute connected
-    redistribute bgp
+    network 2.2.2.2/32
+    
+    redistribute bgp route-map eBGP
 
 router bgp 100
 
@@ -22,3 +24,14 @@
     network 50.7.1.0/24
     neighbor 50.7.1.7 remote-as 7
     neighbor 50.7.1.7 description Router rxa4
+    neighbor 3.3.3.3 remote-as 100
