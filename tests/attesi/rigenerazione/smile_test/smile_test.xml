    <router name="rcdf3">
      <protocols>
        <protocol>bgp</protocol>
        <protocol>rip</protocol>
      </protocols>
      <asn>100</asn>
      <interfaces>
        <interface name="eth0" lan="F" ip="100.3.5.3/24"/>
