    </host>
    <host name="root" ip="20.3.0.2/24" gateway="20.3.0.3" lan="H">
      <dns>1</dns>
      <root_type>master</root_type>
    </host>
    <host name="ns_com" ip="20.1.0.3/24" gateway="20.1.0.1" lan="G">
      <dns>1</dns>
      <root_type>hint</root_type>
      <zones>
        <zone name="com">
          <record name="dns.com">20.1.0.3</record>
          <record name="web.com">2.2.0.2</record>
        </zone>
      </zones>
    </host>
    <host name="ns_local" ip="1.0.0.2/24" gateway="1.0.0.1" lan="N">
      <dns>1</dns>
      <root_type>hint</root_type>
      <allow_recursion>any</allow_recursion>
      <dnssec_validation>1</dnssec_validation>
    </host>
  </hosts>
  <www>
    <server name="web_srv" ip="2.2.0.2/24" gateway="2.2.0.3" lan="A"/>
  </www>
