<?xml version="1.0" encoding="utf-8"?>
<lab name="test">
  <routers>
    <router name="r1">
      <protocols>
        <protocol>bgp</protocol>
      </protocols>
      <asn>1</asn>
      <interfaces>
        <interface name="eth0" lan="A" ip="10.0.0.1/24"/>
        <interface name="eth1" lan="B" ip="20.0.0.1/24"/>
      </interfaces>
    </router>
    <router name="r2">
      <protocols>
        <protocol>bgp</protocol>
      </protocols>
      <asn>2</asn>
      <interfaces>
        <interface name="eth0" lan="A" ip="10.0.0.2/24"/>
        <interface name="eth1" lan="C" ip="30.0.0.1/24"/>
      </interfaces>
    </router>
    <router name="r3">
      <protocols>
        <protocol>bgp</protocol>
      </protocols>
      <asn>3</asn>
      <interfaces>
        <interface name="eth0" lan="B" ip="20.0.0.2/24"/>
      </interfaces>
    </router>
    <router name="r4">
      <protocols>
        <protocol>bgp</protocol>
      </protocols>
      <asn>4</asn>
      <interfaces>
        <interface name="eth0" lan="C" ip="30.0.0.2/24"/>
      </interfaces>
    </router>
  </routers>
  <hosts/>
  <www/>
  <lab_conf>r1[0]=A
r1[1]=B
r1[image]="kathara/frr"

r2[0]=A
r2[1]=C
r2[image]="kathara/frr"

r3[0]=B
r3[image]="kathara/frr"

r4[0]=C
r4[image]="kathara/frr"
</lab_conf>
</lab>
