<?xml version="1.0" encoding="utf-8"?>
<lab name="bgp_ibgp_due_as">
  <routers>
    <router name="r1">
      <protocols>
        <protocol>bgp</protocol>
        <protocol>ospf</protocol>
      </protocols>
      <asn>100</asn>
      <ospf_area>0.0.0.0</ospf_area>
      <interfaces>
        <interface name="eth0" lan="A" ip="10.0.0.1/24"/>
        <interface name="eth1" lan="X" ip="192.168.0.1/30"/>
      </interfaces>
      <igp_redistribute_bgp>0</igp_redistribute_bgp>
      <igp_networks>
        <igp_network>10.0.0.0/8</igp_network>
      </igp_networks>
    </router>
    <router name="r2">
      <protocols>
        <protocol>bgp</protocol>
        <protocol>ospf</protocol>
      </protocols>
      <asn>100</asn>
      <ospf_area>0.0.0.0</ospf_area>
      <interfaces>
        <interface name="eth0" lan="A" ip="10.0.0.2/24"/>
      </interfaces>
      <igp_networks>
        <igp_network>10.0.0.0/8</igp_network>
      </igp_networks>
    </router>
    <router name="r3">
      <protocols>
        <protocol>bgp</protocol>
      </protocols>
      <asn>200</asn>
      <interfaces>
        <interface name="eth0" lan="X" ip="192.168.0.2/30"/>
        <interface name="eth1" lan="Y" ip="200.0.0.1/24"/>
      </interfaces>
    </router>
  </routers>
  <hosts>
    <host name="pc1" ip="200.0.0.10/24" gateway="200.0.0.1" lan="Y" gw_dev="eth0">
      <interfaces>
        <interface name="eth0" lan="Y" ip="200.0.0.10/24"/>
      </interfaces>
    </host>
  </hosts>
  <www/>
  <lab_conf>r1[0]=A
r1[1]=X
r1[image]="kathara/frr"

r2[0]=A
r2[image]="kathara/frr"

r3[0]=X
r3[1]=Y
r3[image]="kathara/frr"

pc1[0]=Y
pc1[image]="kathara/base"
</lab_conf>
</lab>
