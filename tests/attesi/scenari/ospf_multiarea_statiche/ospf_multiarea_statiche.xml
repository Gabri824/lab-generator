<?xml version="1.0" encoding="utf-8"?>
<lab name="ospf_multiarea_statiche">
  <routers>
    <router name="r1">
      <protocols>
        <protocol>bgp</protocol>
        <protocol>ospf</protocol>
      </protocols>
      <asn>100</asn>
      <ospf_area>0.0.0.0</ospf_area>
      <interfaces>
        <interface name="eth0" lan="A" ip="10.0.0.1/30"/>
        <interface name="eth1" lan="B" ip="10.0.1.1/30"/>
      </interfaces>
      <igp_networks>
        <igp_network>10.0.0.0/8</igp_network>
      </igp_networks>
    </router>
    <router name="r2">
      <protocols>
        <protocol>ospf</protocol>
      </protocols>
      <ospf_area>1.1.1.1</ospf_area>
      <ospf_area_stub>1</ospf_area_stub>
      <interfaces>
        <interface name="eth0" lan="A" ip="10.0.0.2/30"/>
        <interface name="eth1" lan="C" ip="10.1.0.1/24"/>
      </interfaces>
      <igp_networks>
        <igp_network>10.0.0.0/8</igp_network>
      </igp_networks>
    </router>
    <router name="r3">
      <protocols>
        <protocol>ospf</protocol>
        <protocol>statico</protocol>
      </protocols>
      <ospf_area>0.0.0.0</ospf_area>
      <interfaces>
        <interface name="eth0" lan="B" ip="10.0.1.2/30"/>
      </interfaces>
      <igp_networks>
        <igp_network>10.0.0.0/8</igp_network>
      </igp_networks>
      <static_routes>
        <route network="default" via="10.0.1.1"/>
        <route network="30.0.0.0/24" via="10.0.1.1" dev="eth0"/>
      </static_routes>
    </router>
  </routers>
  <hosts>
    <host name="host1" ip="10.1.0.10/24" gateway="10.1.0.1" lan="C" gw_dev="eth0">
      <interfaces>
        <interface name="eth0" lan="C" ip="10.1.0.10/24"/>
        <interface name="eth1" lan="D" ip="192.168.5.10/24"/>
      </interfaces>
    </host>
  </hosts>
  <www/>
  <lab_conf>r1[0]=A
r1[1]=B
r1[image]="kathara/frr"

r2[0]=A
r2[1]=C
r2[image]="kathara/frr"

r3[0]=B
r3[image]="kathara/frr"

host1[0]=C
host1[1]=D
host1[image]="kathara/base"
</lab_conf>
</lab>
